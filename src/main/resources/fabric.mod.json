{
  "schemaVersion": 1,
  "id": "vulkanmod",
  "version": "${version}",
  "name": "VulkanMod",
  "description": "A Vulkan renderer for Minecraft 1.8.9. Replaces the OpenGL rendering pipeline with an explicit Vulkan backend, including optimised terrain and entity rendering.",
  "authors": [
    "Collateral",
    "VulkanMod contributors",
    "Zarzelcow (Legacy LWJGL3)",
    "hopccne (1.8.9 backport)"
  ],
  "contact": {
    "homepage": "https://github.com/xCollateral/VulkanMod",
    "sources": "https://github.com/xCollateral/VulkanMod",
    "issues": "https://github.com/xCollateral/VulkanMod/issues"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/vulkanmod/vlogo.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.github.zarzelcow.legacylwjgl3.LegacyLWJGL3"
    ],
    "client": [
      "net.vulkanmod.Initializer"
    ]
  },
  "mixins": [
    "legacy-lwjgl3.mixins.json",
    "vulkanmod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.9",
    "minecraft": "1.8.9",
    "java": ">=8"
  }
}
